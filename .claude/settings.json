{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-stop-check.sh\"",
            "timeout": 300,
            "statusMessage": "Running the quick checks"
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(git push*)"
    ],
    "allow": [
      "Bash(bash scripts/check.sh*)",
      "Bash(uv sync*)",
      "Bash(uv run ruff*)",
      "Bash(uv run pyright*)",
      "Bash(uv run pytest*)",
      "Bash(uv lock*)",
      "Bash(terraform fmt*)",
      "Bash(terraform init -backend=false*)",
      "Bash(terraform validate*)",
      "Bash(npm ci*)",
      "Bash(npm test*)",
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run build*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(bash scripts/setup.sh --check*)",
      "Bash(bash scripts/pr-findings.sh *)",
      "Bash(bash .lefthook/pre-push-scan.sh*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr list*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(* --no-verify*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform * apply*)",
      "Bash(terraform * destroy*)",
      "Bash(gh pr review*--approve*)",
      "Bash(gh api *rulesets*)",
      "Bash(bash scripts/protect-main.sh*)",
      "Read(**/*.tfvars)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.dev)",
      "Read(**/.env.prod)",
      "Read(**/.env.production)"
    ]
  }
}
